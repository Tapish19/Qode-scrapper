DATA_DIR=data
LOG_LEVEL=INFO

# Live collection is intentionally disabled by default.
# Set true only for live collection from X/Twitter.
X_SCRAPING_AUTHORIZED=false

# Reuse a manually authenticated Chrome profile. Example paths:
# Windows: C:\\Users\\YOUR_NAME\\AppData\\Local\\Google\\Chrome\\User Data
# Linux: /home/YOUR_NAME/.config/google-chrome
X_CHROME_PROFILE_DIR=
X_CHROME_PROFILE_NAME=Default
X_HEADLESS=false

PAGE_LOAD_TIMEOUT_SECONDS=30
MIN_SCROLL_DELAY_SECONDS=1.8
MAX_SCROLL_DELAY_SECONDS=3.0
MAX_SCROLLS_PER_QUERY=220
PARQUET_BATCH_SIZE=500

PROCESSING_WORKERS=4
MAX_PENDING_RECORDS=32
